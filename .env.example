# Server Configuration
PORT=3000
NODE_ENV=production
TRUST_PROXY=true

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://miniflux:secret@localhost:5432/miniflux?sslmode=disable

# Single-User Authentication & Session
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
SESSION_SECRET=a-long-random-secret-for-signing-cookies
SESSION_TTL_DAYS=30

# Fixed Upstream Miniflux Configuration
MINIFLUX_URL=http://localhost:8080
MINIFLUX_API_TOKEN=your-miniflux-api-token

# Server-Side AI Summary Configuration (OpenAI Compatible)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your-openai-or-deepseek-api-key
AI_MODEL=gpt-4o-mini
AI_PROMPT=You are a helpful reading assistant. Summarize the provided article concisely into: 1) A 1-2 sentence TL;DR. 2) Key bullet points of main arguments or facts. Keep the language matching the article's language.

# Internal API Configuration (for Windmill / automation pipeline integration)
INTERNAL_API_KEY=your-internal-api-secret-key-at-least-32-chars
SUMMARY_AI_MIN_CHARS=500
